# Copia este archivo a bridge/.env (ignorado por git) y completa los valores.
MT5_LOGIN=6190344
MT5_PASSWORD=cambia-esta-password
MT5_SERVER=Swissquote-Server
MT5_TERMINAL_PATH=C:\Program Files\Swissquote Bank MT5 Client Terminal\terminal64.exe
# Secreto compartido: TradingView debe enviarlo en el header X-Webhook-Secret.
WEBHOOK_SECRET=genera-un-secreto-largo
MT5_SYMBOLS=XAUUSD,XAGUSD
# Sufijo del simbolo en el broker si aplica (p.ej. .pro)
SYMBOL_SUFFIX=
MAX_LOTS=1.0
DEVIATION_POINTS=20
MAGIC=20260807
# true = no envia ordenes, solo registra (recomendado para probar)
DRY_RUN=true
